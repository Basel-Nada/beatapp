# BeatApp Environment Configuration

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HighLevel (GoHighLevel) API Integration
# For single MedSpa development / testing, set your Location ID & Private Integration Token:
HIGHLEVEL_LOCATION_ID=your_highlevel_location_id_here
HIGHLEVEL_PRIVATE_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HIGHLEVEL_API_BASE_URL=https://services.leadconnectorhq.com

# For Multi-Tenant HighLevel OAuth Marketplace App
HIGHLEVEL_CLIENT_ID=your_oauth_client_id
HIGHLEVEL_CLIENT_SECRET=your_oauth_client_secret
HIGHLEVEL_REDIRECT_URI=http://localhost:3000/api/auth/highlevel/callback

# Default Calendar ID (Optional)
HIGHLEVEL_DEFAULT_CALENDAR_ID=

# BeatApp Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/beatapp

# Development & Sandbox Mode
# Set to 'true' to explicitly run with in-memory MedSpa mock provider
DEMO_MODE=false
